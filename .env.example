# ---------------------------------------------------------------------------
# Local development only.
#
# Copy to `.env` for `astro dev`, and to `.dev.vars` for `wrangler dev` — the
# Worker runtime reads `.dev.vars`, not `.env`, and not your shell environment.
#
# In production these live in Cloudflare: non-secret values in wrangler.jsonc
# under `vars`, secrets under Settings -> Variables and Secrets.
#
# NEVER commit a real `.env` file. Only variables prefixed with PUBLIC_ are
# exposed to the browser — everything else stays server-side.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical, Open Graph, sitemap, structured data).
PUBLIC_SITE_URL="https://example.com"

# ---------------------------------------------------------------------------
# LEAD DELIVERY
# ---------------------------------------------------------------------------
# How submitted leads are delivered. One of: console | webhook | email | telegram
# "console"  -> DEVELOPMENT ONLY. Leads are printed to the server log and are
#               NOT delivered anywhere. The UI states this explicitly.
# "webhook"  -> POSTs the lead JSON to LEAD_WEBHOOK_URL (CRM, Zapier, Make,
#               Google Apps Script / Google Sheets, n8n, etc.)
# "email"    -> Sends via a transactional email API (see src/utils/leadAdapter.ts)
# "telegram" -> Sends a formatted message to a Telegram chat via your own bot
LEAD_DELIVERY_MODE="console"

# Webhook mode
LEAD_WEBHOOK_URL=""
# Optional shared secret sent as the `X-Webhook-Secret` header.
LEAD_WEBHOOK_SECRET=""

# Email mode (example uses Resend; swap in your provider in leadAdapter.ts)
LEAD_EMAIL_API_KEY=""
LEAD_EMAIL_FROM="Website Enquiries <no-reply@example.com>"
LEAD_EMAIL_TO="[EMAIL ADDRESS]"

# Telegram mode. Create a bot with @BotFather, then find your chat id by
# messaging the bot and opening:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# A personal chat id is a positive number; a group id starts with a minus sign.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------------------------------------------------------------------------
# ANTI-SPAM
# ---------------------------------------------------------------------------
# Minimum seconds between page render and submit (bot heuristic). Default 1.5.
# Raising this rejects genuine visitors who use browser autofill. A retry always
# succeeds, but the first attempt is the one you lose — keep it low.
LEAD_MIN_FILL_SECONDS="1.5"
# Max submissions per IP per rolling window (in-memory; see README for the
# production-grade options: Workers KV, Durable Objects, Cloudflare Turnstile).
LEAD_RATE_LIMIT_MAX="10"
LEAD_RATE_LIMIT_WINDOW_SECONDS="600"

# Cloudflare Turnstile (optional). Get both keys from the Cloudflare dashboard:
# Turnstile -> Add site. You do NOT need to host the site on Cloudflare.
#
# Set BOTH or NEITHER. The site key renders the widget; the secret key makes
# /api/lead verify it. A widget with no secret is decoration; a secret with no
# widget refuses every submission.
#
# NOTE: Turnstile needs JavaScript, so enabling it means the form no longer
# works for visitors with scripting disabled. The honeypot, fill-time check and
# rate limit all work without it and stay in place either way.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
