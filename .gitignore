# Source documents used to build the site, not needed to run it. The sales kit
# is marked "not for circulation" — keep it out of the repository entirely.
/*.pdf

# Working screenshots at the repository root. One of them is a full browser
# window — open tabs, bookmarks, signed-in accounts — and the other is the
# agent portal's unit chart. Neither is needed to build the site and neither
# should leave this machine.
/Screenshot*.png

# Source images for the agent portrait, copied into public/images/agent by the
# build notes. Harmless, but not part of the site.
/agent/

# Cloudflare local state
.wrangler/
