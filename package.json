{
  "name": "chuan-park-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable premium landing page template for Singapore private residential new launches.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "astro": "astro",
    "typecheck": "astro check",
    "format": "prettier --write \"**/*.{astro,ts,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,js,json,css,md}\"",
    "lint": "eslint .",
    "test": "playwright test tests/landing.spec.ts",
    "test:ui": "playwright test --ui",
    "a11y": "playwright test tests/accessibility.spec.ts",
    "linkcheck": "linkinator http://localhost:4321 --config linkinator.config.json",
    "verify": "npm run typecheck && npm run build",
    "test:all": "playwright test",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "linkinator": "^6.1.2",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.3.0"
  }
}
