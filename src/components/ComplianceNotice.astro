---
/**
 * ADVERTISER IDENTITY NOTICE
 * ---------------------------------------------------------------------------
 * The first thing on the page, above the header, on every route.
 *
 * Shown IN FULL, with no expander. An earlier version put the licence number
 * and the verification link behind a "Details" toggle. Both comparable sites
 * that were reinstated after an Unacceptable Business Practices suspension
 * (The Continuum, Lentor Gardens Residences) show the whole sentence, and a
 * disclosure a visitor has to open is a disclosure some visitors never see.
 *
 * Not dismissible. A notice that can be closed is a notice that was not shown.
 *
 * Rendered only when the identity is complete — a half-filled notice would look
 * like a disclosure while failing to identify anyone.
 */
import { agent, isPlaceholder } from '../data/agent';
import { site } from '../data/site';

const cea = isPlaceholder(agent.ceaRegistrationNumber) ? null : agent.ceaRegistrationNumber;
const licence = isPlaceholder(agent.agencyLicenceNumber) ? null : agent.agencyLicenceNumber;
const register = isPlaceholder(agent.ceaPublicRegisterUrl) ? null : agent.ceaPublicRegisterUrl;
const complete = Boolean(cea && licence && !site.legal.claimsOfficialDeveloperSite);
---

{
  complete && (
    <aside class="compliance" aria-label="Advertiser identity notice">
      <p class="compliance__text container">
        <strong>Important Notice:</strong> This is an independent property marketing website operated
        by {agent.fullName} (CEA Reg. No. {cea}), a licensed salesperson with {agent.agencyName} (CEA
        Licence No. {licence}). This is not the official developer website and is not operated by the
        developer. All information is for general reference only.
        {register && (
          <>
            {' '}
            <a class="compliance__link" href={register} target="_blank" rel="noopener noreferrer">
              Verify on CEA Register
              <span aria-hidden="true"> ↗</span>
              <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </>
        )}
      </p>
    </aside>
  )
}

<style>
  .compliance {
    background: var(--c-ink, #1b1a18);
    color: var(--c-on-inverse, #f4f1ea);
  }

  .compliance__text {
    margin: 0 auto;
    padding-block: var(--sp-2);
    font-size: var(--step--1);
    line-height: 1.5;
    text-align: center;
  }

  .compliance__text strong {
    font-weight: 600;
  }

  .compliance__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    white-space: nowrap;
  }

  .compliance__link:hover,
  .compliance__link:focus-visible {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 47.99rem) {
    .compliance__text {
      text-align: left;
      font-size: var(--step--2);
    }
  }
</style>
