---
/**
 * HORIZONTAL CAROUSEL
 * ---------------------------------------------------------------------------
 * A scroll container with snap points, plus prev/next buttons.
 *
 * WHAT MAKES IT SAFE
 * The mechanism is the browser's own overflow scrolling: it works with a
 * trackpad, a touch swipe, and the keyboard (the track is focusable and takes
 * arrow keys) with no JavaScript at all. The buttons are an enhancement, hidden
 * when scripting is off rather than left as dead controls, and they disable
 * themselves at each end.
 *
 * The caller supplies the list. Slide width belongs to the caller too, since
 * only it knows how wide its content wants to be.
 *
 * ONE THING THE CALLER MUST DO
 * If a slide contains absolutely positioned descendants — `.visually-hidden`
 * links, for instance — the slide needs `position: relative`. An absolutely
 * positioned box is not clipped by an ancestor that is not its containing
 * block, so without it those boxes sit at their static position inside the
 * scrolled region and drag the whole document into horizontal overflow.
 */
interface Props {
  /** Describes the track for screen readers, e.g. "Gallery images". */
  label: string;
}

const { label } = Astro.props;
---

<div class="carousel" data-carousel>
  <div class="carousel__track" data-carousel-track role="region" aria-label={label} tabindex="0">
    <slot />
  </div>

  <div class="carousel__nav js-only">
    <button type="button" class="carousel__btn" data-carousel-prev>
      <span aria-hidden="true">&#8592;</span>
      <span class="visually-hidden">Scroll back through {label}</span>
    </button>
    <button type="button" class="carousel__btn" data-carousel-next>
      <span aria-hidden="true">&#8594;</span>
      <span class="visually-hidden">Scroll forward through {label}</span>
    </button>
  </div>
</div>

<style>
  .js-only {
    display: none;
  }

  :global(html.js) .js-only {
    display: flex;
  }

  .carousel {
    display: grid;
    /* minmax(0, …), not 1fr: a grid item defaults to min-width:auto, so the
       track would size to its full content width and drag the page into
       horizontal overflow instead of scrolling inside itself. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-4);
  }

  .carousel__track {
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--sp-1);
    /* Room for a slide's focus ring, which the scroll container would clip. */
    padding: var(--sp-1);
    scrollbar-width: thin;
  }

  .carousel__track:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
    border-radius: var(--card-radius);
  }

  .carousel__nav {
    gap: var(--sp-2);
    justify-content: flex-end;
  }

  .carousel__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--c-line-strong);
    border-radius: 50%;
    background: var(--c-paper);
    color: var(--c-ink);
    font-size: var(--step-0);
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .carousel__btn:hover:not(:disabled) {
    border-color: var(--c-accent);
    background: var(--c-paper-2);
  }

  .carousel__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
</style>

<script>
  /*
   * Wires every carousel on the page. Enhancement only: the track scrolls
   * without this, so a failure here costs the buttons, not the content.
   */
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !prev || !next) return;

    const list = track.firstElementChild;

    const step = () => {
      const slide = list?.firstElementChild as HTMLElement | null;
      // One slide plus the gap, so a click advances by exactly one.
      return slide ? slide.getBoundingClientRect().width + 16 : track.clientWidth * 0.8;
    };

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', sync, { passive: true });

    /*
     * Slides are sized by lazily-loaded images, so the track's scrollWidth is
     * wrong until those arrive — a first sync() on a track that is not yet
     * overflowing would disable "next" and leave it disabled. Watching for size
     * changes covers image load, window resize and font swap in one.
     */
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(sync).observe(list ?? track);
    } else {
      window.addEventListener('resize', sync);
      window.addEventListener('load', sync);
    }

    sync();
  });
</script>
