---
/**
 * LANDING PAGE
 * ---------------------------------------------------------------------------
 * Section order is fixed and matches the navigation:
 * Hero → About → Location → Price → Floorplans → Brochure → Gallery →
 * Developer → FAQ → Contact → Footer.
 *
 * The adviser's identification lives inside the Contact section rather than in
 * a section of its own — it belongs next to the form it vouches for.
 *
 * Prerendered to static HTML: every fact a visitor or a crawler needs is in
 * the initial response, with no client-side data fetching.
 */
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Location from '../components/Location.astro';
import PriceTable from '../components/PriceTable.astro';
import Floorplans from '../components/Floorplans.astro';
import Brochure from '../components/Brochure.astro';
import Gallery from '../components/Gallery.astro';
import Developer from '../components/Developer.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import Lightbox from '../components/Lightbox.astro';

import { project, verified } from '../data/project';
import { agent } from '../data/agent';
import { buildGraph } from '../utils/structuredData';

const projectName = verified(project.name) ?? '[PROJECT NAME]';
const location = verified(project.locality) ?? verified(project.district) ?? 'Singapore';
const district = verified(project.district);

/*
 * TITLE AND DESCRIPTION
 * ---------------------------------------------------------------------------
 * The advertiser comes first, then the project.
 *
 * "Chuan Park — Price, Floorplans & Showflat" reads as the project's own site,
 * which is the impression that gets a lead-generation page suspended for
 * misrepresentation. Leading with the salesperson, the agency and the CEA
 * registration makes the nature of the site unambiguous in the tab, in the
 * search result and in every link preview — the three places a visitor judges
 * it before the page has even rendered.
 *
 * The project name is still present and still early, so the ad groups built
 * around it keep their relevance.
 */
const advertiser = agent.fullName;
const cea = verified(agent.ceaRegistrationNumber);
const identity = cea ? `${advertiser} | ${agent.agencyName} (${cea})` : advertiser;

const title = `${identity} | Marketing ${projectName}`;

const description =
  `${advertiser}, licensed real estate salesperson${cea ? ` (CEA Reg. No. ${cea})` : ''} with ` +
  `${agent.agencyName}, marketing ${projectName} — a new private residential launch in ` +
  `${location}${district ? `, ${district}` : ''}. Independent marketing website, not the official ` +
  `developer website. Indicative pricing, unit types, floorplans and showflat enquiries.`;

const jsonLd = buildGraph({
  pathname: '/',
  title,
  description,
  includeFaq: true,
  includeResidence: true,
  breadcrumbs: [{ name: projectName, path: '/' }],
});
---

<BaseLayout title={title} description={description} pathname="/" jsonLd={jsonLd}>
  <Hero />
  <About />
  <Location />
  <PriceTable />
  <Floorplans />
  <Brochure />
  <Gallery />
  <Developer />
  <Faq />
  <ContactForm />
  <Lightbox />
</BaseLayout>
